# Copy to .env.local

# LLM (SYNNOD_PROJECT.md section 8/11). Without a key the mind stays quiet:
# scenarios are saved, but no replies or thoughts are invented.
ANTHROPIC_API_KEY=
# SYNNOD_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Bearer secret for POST /api/cron/thoughts (call it every 1-3 hours from a scheduler)
CRON_SECRET=

# Postgres connection string (Neon, Supabase, ...). REQUIRED on Vercel/serverless.
# Leave empty locally to use the embedded PGlite database in .data/synnod.
DATABASE_URL=

# Embedded database folder (local only). Default: .data/synnod
# SYNNOD_DB_DIR=.data/synnod

# Showcase deploys without a database: open in simulated DEMO mode by default.
# NEXT_PUBLIC_SYNNOD_DEFAULT_DEMO=1
