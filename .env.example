# Copy to .env.local

# ---------------------------------------------------------------- LLM ------
# Without a key the mind stays quiet: scenarios are saved, but no replies or
# thoughts are invented. A FREE key with no credit card is enough:
#   gemini      https://aistudio.google.com/apikey   (default, most generous)
#   groq        https://console.groq.com/keys
#   openrouter  https://openrouter.ai/keys           (":free" models)
# Note: free tiers may use prompts to improve their products. Fine for a demo;
# use a paid/private tier before real users share sensitive things.
LLM_API_KEY=
LLM_PROVIDER=gemini
# Free model names change over time; override when the default stops working.
# LLM_MODEL=gemini-2.5-flash
# Any other OpenAI-compatible API: LLM_PROVIDER=openai + these two.
# LLM_BASE_URL=https://example.com/v1
# Alternative: Anthropic (paid)
# ANTHROPIC_API_KEY=

# Bearer secret for POST /api/cron/thoughts (call it every 1-3 hours from a scheduler)
CRON_SECRET=

# ----------------------------------------------------------- database ------
# Postgres connection string (Neon, Supabase, ...). REQUIRED on Vercel/serverless.
# Leave empty locally to use the embedded PGlite database in .data/synnod.
DATABASE_URL=
# SYNOD_DB_DIR=.data/synnod

# -------------------------------------------- Robinhood Chain + token ------
# Claiming a node can require holding a token on Robinhood Chain (Arbitrum L2).
# Leave the address empty and claiming stays free.
#   npm run contract:deploy   deploys the tSYNOD test token to the testnet and
#                             prints the values below (needs a little test ETH
#                             for gas: https://faucet.testnet.chain.robinhood.com)
# NEXT_PUBLIC_SYNOD_CHAIN=testnet          # testnet (46630) | mainnet (4663)
NEXT_PUBLIC_SYNOD_TOKEN_ADDRESS=
# NEXT_PUBLIC_SYNOD_TOKEN_SYMBOL=tSYNOD
# NEXT_PUBLIC_SYNOD_TOKEN_DECIMALS=18
# NEXT_PUBLIC_SYNOD_MIN_HOLD=100           # whole tokens needed to claim
# NEXT_PUBLIC_SYNOD_TOKEN_FAUCET=1         # 1 only for the test token (it has faucet())
# SYNOD_RPC_URL=                           # override the public RPC (e.g. Alchemy)

# When the launchpad issues the real token: set NEXT_PUBLIC_SYNOD_TOKEN_ADDRESS to
# it, SYMBOL/DECIMALS to match, remove TOKEN_FAUCET, and redeploy. Nothing else changes.

# ------------------------------------------------------------- misc --------
# Showcase deploys without a database: open in simulated DEMO mode by default.
# NEXT_PUBLIC_SYNNOD_DEFAULT_DEMO=1
